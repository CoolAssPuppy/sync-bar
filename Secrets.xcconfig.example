// SyncNerds OAuth client credentials.
//
// Copy this file to Secrets.xcconfig and fill in the values, or run
// `scripts/pull-secrets.sh` to pull them from the Doppler `sync-bar` project.
// Secrets.xcconfig is gitignored and is baked into the app's Info.plist at
// build time. Leaving values empty is fine — the matching OAuth connect button
// is disabled until its credentials are present.

NOTION_CLIENT_ID =
NOTION_CLIENT_SECRET =
LINEAR_CLIENT_ID =
LINEAR_CLIENT_SECRET =
GOOGLE_CLIENT_ID =
GOOGLE_CLIENT_SECRET =
// X (Twitter) OAuth 2.0. The client id is required; the secret is optional —
// leave it empty for a public PKCE client, set it for a confidential client.
X_CLIENT_ID =
X_CLIENT_SECRET =

// PostHog product analytics. The phc_ project key is write-only and safe to
// ship. Leave empty to disable analytics entirely (e.g. local dev builds).
POSTHOG_API_KEY =

// Polar (paid Sync class). None of these are secret — the org id and the
// checkout/portal URLs are public, and the usage relay URL points at the server
// that holds the Polar access token (the token never ships in the app). Leave
// empty until the Polar product exists; the paywall disables Subscribe and the
// usage reporter no-ops until they're populated.
POLAR_ORG_ID =
POLAR_CHECKOUT_URL =
POLAR_PORTAL_URL =
POLAR_USAGE_RELAY_URL =
// Shared secret the app sends to the usage relay (header x-relay-token) so the
// billing sink isn't open to anonymous callers. Must match RELAY_SHARED_SECRET on
// the deployed relay. Leave empty until the relay is deployed.
POLAR_RELAY_TOKEN =
