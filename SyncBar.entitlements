<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Lets the hardened-runtime app send Apple Events to Notes.app so the
	Apple Notes destination can create folders and notes. macOS still gates
	this behind a one-time TCC consent prompt (NSAppleEventsUsageDescription).
	-->
	<key>com.apple.security.automation.apple-events</key>
	<true/>

	<!--
	Token storage moves to the data-protection keychain under this team-prefixed
	access group, so access is gated by the entitlement instead of a per-binary
	ACL and the "allow keychain access" prompt never appears. Requires a
	provisioning profile (created once via Xcode automatic signing).
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.strategicnerds.SyncBar</string>
	</array>
</dict>
</plist>
